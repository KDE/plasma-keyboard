msgid "If supported, the device will vibrate when a key is pressed"
msgstr ""
"Η συσκευή θα δονείται όταν πατάτε ένα πλήκτρο, εφόσον υποστηρίζει δόνηση"

#: ui/main_mediacenter.qml:86
msgid "General"
msgstr "Γενικά"

