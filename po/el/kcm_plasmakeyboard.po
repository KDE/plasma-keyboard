msgctxt "%1 is the number of enabled keyboard layouts"
msgid "%1 keyboard layout selected"
msgid_plural "%1 keyboard layouts selected"
msgstr[0] "Επιλέχθηκε %1 διάταξη πληκτρολογίου"
msgstr[1] "Επιλέχθηκαν %1 διατάξεις πληκτρολογίου"

#: ui/main_mediacenter.qml:55
msgid "Key press feedback"
msgstr "Ανάδραση κατά το πάτημα πλήκτρου"

#: ui/main_mediacenter.qml:64
msgctxt "This is a noun"
msgid "Sound"
msgstr "Ήχος"

#: ui/main_mediacenter.qml:65
msgid "A sound will play when a key is pressed"
msgstr "Θα ακούγεται ήχος όταν πατάτε ένα πλήκτρο"

