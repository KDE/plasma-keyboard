#: ui/main_handset.qml:34
msgctxt "@title:group"
msgid "Feedback"
msgstr "Обратна връзка"

#: ui/main_handset.qml:41
msgid "Whether to emit a sound on key press"
msgstr "Издаване на звук при натискане на клавиш"

#: ui/main_handset.qml:52
msgid "Whether to vibrate on key press"
msgstr "Вибриране при натискане на клавиш"

#: ui/main_handset.qml:70
msgid "Keyboard Languages"
