msgstr "Автоматично изписване на първата буква от изреченията с главна буква"

#: ui/main_mediacenter.qml:19
msgid "On-Screen Keyboard"
msgstr "Виртуална клавиатура"

#: ui/main_mediacenter.qml:43
msgid ""
"No languages selected, the default keyboard layout for the system will be "
"used"
msgstr ""
"Няма избрани езици, ще се използва стандартното разпределение на "
"клавиатурата за системата"

#: ui/main_mediacenter.qml:45
msgctxt "%1 is the number of enabled locales"
msgid "%1 language selected"
msgid_plural "%1 languages selected"
msgstr[0] "Избран е %1 език"
msgstr[1] "Избрани са %1 езика"

#: ui/main_mediacenter.qml:54
msgid "Key press feedback"
msgstr "Обратна връзка при натискане на клавиш"

#: ui/main_mediacenter.qml:63
msgctxt "This is a noun"
msgid "Sound"
msgstr "Звук"

#: ui/main_mediacenter.qml:64
msgid "A sound will play when a key is pressed"
msgstr "Възпроизвеждане на звук при натискане на клавиш"

#: ui/main_mediacenter.qml:74
msgid "If supported, the device will vibrate when a key is pressed"
msgstr "Ако се поддържа, устройството ще вибрира при натискане на клавиш"

#: ui/main_mediacenter.qml:83
msgid "General"
msgstr "Общи"

#: ui/main_mediacenter.qml:93
msgid "Automatically capitalize the beginning of sentences and proper nouns"
msgstr ""
"Автоматично изписване с главна буква на началото на изреченията и "
"собствените имена"

#: ui/main_mediacenter.qml:102
msgctxt "'Alternate' is an adjective here"
msgid "Alternate characters"
msgstr "Алтернативни символи"

#: ui/main_mediacenter.qml:111
msgid "Show overlay when holding a key"
msgstr "Показване на символа при задържане на клавиш"

#: ui/main_mediacenter.qml:112
msgid ""
"Long-pressing a key on a physical keyboard will show an overlay with "
"alternate versions of the selected character, if available"
msgstr ""
"Дълго натискане на клавиш от физическа клавиатура ще покаже панел с "
"алтернативни варианти на избрания символ, ако са налични"

#: ui/main_mediacenter.qml:124 ui/main_mediacenter.qml:137
msgctxt "How long a key must be held before triggering an action"
msgid "Hold delay"
msgstr "Закъснение при задържане"

#: ui/main_mediacenter.qml:125
msgid "How long a key must be held before the overlay shows"
msgstr "Време за задържане на клавиш преди показване на панела"

#: ui/main_mediacenter.qml:128 ui/main_mediacenter.qml:173
msgid "%1 millisecond"
msgid_plural "%1 milliseconds"
msgstr[0] "%1 милисекунда"
msgstr[1] "%1 милисекунди"
