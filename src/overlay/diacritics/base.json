{
    "version": 1,
    "description": "Base Latin-script diacritics and symbol alternates (pan-European superset)",
    "map": {
        "a": ["á", "à", "â", "ä", "ã", "å", "ā", "ă", "ą", "æ"],
        "c": ["ç", "ć", "č", "©"],
        "d": ["ď", "đ", "ð"],
        "e": ["é", "è", "ê", "ë", "ē", "ė", "ę", "ě"],
        "g": ["ğ", "ġ"],
        "h": ["ħ"],
        "i": ["í", "ì", "î", "ï", "ī", "į"],
        "k": ["ķ"],
        "l": ["ł", "ľ", "ļ", "ĺ"],
        "m": ["µ"],
        "n": ["ñ", "ń", "ň", "ņ", "№"],
        "o": ["ó", "ò", "ô", "ö", "õ", "ō", "ø", "ő", "œ"],
        "p": ["¶"],
        "r": ["ř", "ŗ", "®"],
        "s": ["ś", "š", "ş", "ß", "§"],
        "t": ["ť", "ţ", "ŧ", "þ", "™"],
        "u": ["ú", "ù", "û", "ü", "ū", "ů", "ű", "ų"],
        "x": ["x̄"],
        "y": ["ý", "ÿ"],
        "z": ["ź", "ż", "ž"],

        "0": ["°", "∅"],
        "1": ["¹", "½", "⅓", "¼", "⅕", "⅙", "⅐", "⅛", "⅑", "⅒"],
        "2": ["²", "⅔", "⅖"],
        "3": ["³", "¾", "⅜", "⅗"],
        "4": ["⁴", "⅘"],
        "5": ["⁵", "⅝", "⅚"],
        "6": ["⁶"],
        "7": ["⁷", "⅞"],
        "8": ["⁸"],
        "9": ["⁹"],

        "$": ["€", "£", "¥", "¢", "₹"],
        "€": ["$", "£", "¥", "¢", "₹"],
        "£": ["$", "€", "¥", "¢", "₹"],
        "¥": ["$", "€", "£", "¢", "₹"],
        "¢": ["$", "€", "£", "¥", "₹"],
        "₹": ["$", "€", "£", "¥", "¢"],
        "!": ["¡", "‽"],
        "?": ["¿", "‽"],
        ".": ["…", "·", "•"],
        "-": ["–", "—", "←", "→", "↑", "↓", "↔"],
        "\"": ["“", "”", "«", "»"],
        "'": ["‘", "’", "‹", "›"],

        "=": ["≠", "≈", "≡", "≙", "⇆"],
        "<": ["≤", "«", "‹", "←"],
        ">": ["≥", "»", "›", "→"],
        "+": ["±", "†"],
        "*": ["×", "‡", "≛"],
        "/": ["÷", "✓"],
        "%": ["‰"]
    }
}
